        "ios": "2.2081"
    },
    "id": "dasshu.badgified",
    "name": "Badgified",
    "version": "v1.0.3-beta",
    "developer": "DasshuDev",
    "description": "Easy to use API for adding custom badges!",
    "dependencies": {
        "geode.node-ids": ">=v1.20.0"
    },
    "resources": {
        "sprites": [
            "resources/*.png"
        ]
    },
    "api": {
        "include": [
            "include/*.hpp"
        ]
    },
    "links": {
        "homepage": "https://dasshu.dev/",
        "source": "https://github.com/DasshuDev/badgified"
    },
    "tags": [
        "developer",
        "interface",
        "api"
    ],
    "settings": {
        "alternative-profile-badge-design": {
            "name": "Show Badges Under Username",
            "description": "Shows badges <cg>under</c> the username instead of <cy>beside</c> it on the profile.",
            "type": "bool",
            "default": true
        }
    }
